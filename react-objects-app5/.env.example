# URL base da API de objetos locais (sem barra no final)
VITE_API_BASE_URL=http://192.168.0.53:5001

# URL base da API de objetos no S3 (sem barra no final)
VITE_S3_API_BASE_URL=http://192.168.0.53:5002

# ---- Configuracao futura do Keycloak (ainda nao habilitada) ----
# Quando a autenticacao JWT via Keycloak for ativada, preencha os
# valores abaixo e habilite o provider em src/main.jsx.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=meu-realm
VITE_KEYCLOAK_CLIENT_ID=objects-manager-web
