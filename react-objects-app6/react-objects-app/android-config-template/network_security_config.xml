<?xml version="1.0" encoding="utf-8"?>
<!--
  Este arquivo precisa ser copiado para:
    android/app/src/main/res/xml/network_security_config.xml
  (crie a pasta "xml" se ela nao existir)

  Ele libera trafego HTTP puro (sem TLS) apenas para os hosts das suas
  APIs locais. Ajuste os <domain> abaixo para o IP/host real onde o
  backend roda (o mesmo valor de VITE_API_BASE_URL / VITE_S3_API_BASE_URL,
  sem "http://" e sem porta).
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">192.168.0.53</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">localhost</domain>
  </domain-config>
</network-security-config>
